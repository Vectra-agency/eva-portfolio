# Password for /admin-editor
ADMIN_PASSWORD=

# GitHub fine-grained token with "Contents: Read and write" on this repository.
# Leave empty locally to save straight into the project files.
GITHUB_TOKEN=
# owner/repo
GITHUB_REPO=Vectra-agency/eva-portfolio
# Branch Vercel deploys from
GITHUB_BRANCH=main

# Optional: any long random string, strengthens the session signature
SESSION_SECRET=
